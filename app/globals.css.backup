:root{--bg:#f4f3ef;--paper:#fbfaf6;--ink:#101315;--muted:#5f6567;--line:#d8d7d1;--accent:#d83e55;--deep:#11181c;--max:1240px}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--ink);font-family:Arial,Helvetica,sans-serif;line-height:1.5}a{color:inherit;text-decoration:none}.site-header{height:76px;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:32px;padding:0 max(24px,calc((100vw - var(--max))/2));background:rgba(244,243,239,.94);backdrop-filter:blur(14px);position:sticky;top:0;z-index:20;border-bottom:1px solid var(--line)}.brand{font-weight:900;letter-spacing:-1.5px;font-size:21px}.brand span{color:var(--accent)}nav{display:flex;gap:24px;font-size:13px;font-weight:700}nav a:hover{color:var(--accent)}.brief-pill{justify-self:end;border:1px solid var(--ink);border-radius:999px;padding:9px 14px;font-size:12px;font-weight:800}.subnav{max-width:var(--max);margin:auto;height:38px;display:flex;align-items:center;justify-content:space-between;font-size:11px;letter-spacing:.03em;color:var(--muted);border-bottom:1px solid var(--line)}main{overflow:hidden}.hero{max-width:var(--max);margin:auto;min-height:650px;display:grid;grid-template-columns:1.02fr .98fr;align-items:center;gap:70px;padding:72px 0}.eyebrow{font-size:11px;letter-spacing:.16em;font-weight:900}.hero h1,.topic-hero h1,.prose-page h1,.article-hero h1{font-family:Georgia,'Times New Roman',serif;font-size:clamp(62px,8vw,116px);line-height:.88;letter-spacing:-.055em;margin:20px 0 26px}.hero h1 em{font-weight:400;color:var(--accent)}.hero-copy>p{font-size:22px;max-width:540px;color:var(--muted)}.hero-actions{display:flex;gap:12px;margin-top:34px}.primary,.secondary{padding:14px 18px;font-size:13px;font-weight:800}.primary{background:var(--ink);color:white}.primary.light{background:white;color:var(--ink)}.secondary{border:1px solid var(--line)}.hero-art{position:relative;height:500px;background:var(--deep);overflow:hidden}.hero-retina{position:absolute;width:430px;height:430px;border-radius:50%;left:50%;top:47%;transform:translate(-50%,-50%);background:radial-gradient(circle at 50% 50%,#3d1620 0,#7c1f31 30%,#43121d 55%,#14090d 74%,#090b0c 100%);box-shadow:0 0 0 1px rgba(255,255,255,.15),0 0 90px rgba(216,62,85,.28)}.hero-retina:before,.hero-retina:after{content:"";position:absolute;inset:40px;border-radius:50%;border:1px solid rgba(255,255,255,.12)}.hero-retina:after{inset:95px}.optic-disc{position:absolute;width:56px;height:56px;border-radius:50%;background:radial-gradient(circle,#ffd6a5,#d98b72 60%,rgba(255,255,255,0));left:60%;top:46%;box-shadow:0 0 35px rgba(255,180,150,.6)}.vessel{position:absolute;left:62%;top:51%;height:2px;background:linear-gradient(90deg,#f5a6a1,transparent);transform-origin:left center}.v1{width:160px;transform:rotate(25deg)}.v2{width:180px;transform:rotate(-38deg)}.v3{width:145px;transform:rotate(145deg)}.hero-caption{position:absolute;left:18px;bottom:18px;color:white;display:flex;flex-direction:column;font-size:10px;letter-spacing:.12em}.hero-caption b{font-size:12px;margin-top:4px}.lead-section,.frontier,.latest,.topics,.topic-content,.related{max-width:var(--max);margin:0 auto;padding:80px 0}.section-kicker{font-size:11px;letter-spacing:.14em;font-weight:900;margin-bottom:24px}.section-kicker span{color:var(--accent);margin-right:12px}.article-card{display:grid;background:var(--paper);border:1px solid var(--line);transition:.2s transform,.2s box-shadow}.article-card:hover{transform:translateY(-3px);box-shadow:0 16px 44px rgba(0,0,0,.08)}.article-card.large{grid-template-columns:1.1fr .9fr;min-height:460px}.card-visual{min-height:230px;background:#15191b;position:relative;overflow:hidden}.large .card-visual{min-height:460px}.retina-orb{width:230px;height:230px;border-radius:50%;position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);background:radial-gradient(circle at 58% 48%,#eca9a4 0 2%,#791e30 5%,#5b1724 30%,#2b1017 60%,#0c0e0f 76%);box-shadow:0 0 70px rgba(216,62,85,.18)}.large .retina-orb{width:390px;height:390px}.retina-orb span{position:absolute;inset:22%;border:1px solid rgba(255,255,255,.12);border-radius:50%}.scanlines{position:absolute;inset:0;background:repeating-linear-gradient(0deg,transparent 0 11px,rgba(255,255,255,.025) 12px)}.card-copy{padding:34px}.large .card-copy{display:flex;flex-direction:column;justify-content:center;padding:58px}.card-copy h3{font-family:Georgia,serif;font-size:28px;line-height:1.05;letter-spacing:-.025em;margin:13px 0}.large .card-copy h3{font-size:46px}.card-copy p{color:var(--muted)}.meta{font-size:11px;font-weight:800;margin-top:20px}.section-heading{display:flex;justify-content:space-between;align-items:end;margin-bottom:34px}.section-heading h2,.window h2,.brief h2,.related h2{font-family:Georgia,serif;font-size:52px;letter-spacing:-.04em;line-height:.98;margin:0}.section-heading>p{max-width:420px;color:var(--muted)}.frontier-grid{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.frontier-item{padding:28px 24px 30px 0;border-right:1px solid var(--line);min-height:310px}.frontier-item+ .frontier-item{padding-left:24px}.frontier-item:last-child{border-right:0}.frontier-item>span{font-family:Georgia,serif;font-size:42px;color:#c9c7c0}.frontier-item h3{font-family:Georgia,serif;font-size:24px;line-height:1.05}.frontier-item p{font-size:13px;color:var(--muted)}.cards-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:24px}.topic-grid{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid var(--line);border-left:1px solid var(--line)}.topic-grid a{padding:34px;min-height:260px;border-right:1px solid var(--line);border-bottom:1px solid var(--line)}.topic-grid a>span{color:var(--accent);font-size:11px;font-weight:900}.topic-grid h3{font-family:Georgia,serif;font-size:34px;margin:40px 0 10px}.topic-grid p{font-size:13px;color:var(--muted)}.topic-grid b{font-size:12px}.window{max-width:var(--max);margin:60px auto 0;background:var(--deep);color:white;min-height:520px;display:grid;grid-template-columns:1fr 1fr;align-items:center;padding:70px}.window p{color:#c9d0d2;max-width:530px;font-size:18px;margin-bottom:30px}.window-art{height:350px;position:relative}.rings{position:absolute;width:320px;height:320px;border-radius:50%;left:50%;top:50%;transform:translate(-50%,-50%);border:1px solid rgba(255,255,255,.25);box-shadow:inset 0 0 0 60px rgba(216,62,85,.06),inset 0 0 0 120px rgba(216,62,85,.05)}.axis{position:absolute;background:rgba(255,255,255,.18)}.axis.x{left:5%;right:5%;height:1px;top:50%}.axis.y{top:5%;bottom:5%;width:1px;left:50%}.brief{max-width:900px;margin:0 auto;text-align:center;padding:130px 20px}.brief h2{font-size:60px;margin:18px 0}.brief p{color:var(--muted);font-size:18px}.brief form{display:flex;max-width:560px;margin:32px auto 14px}.brief input{flex:1;border:1px solid var(--line);background:var(--paper);padding:16px;font-size:14px}.brief button{border:0;background:var(--ink);color:white;padding:0 22px;font-weight:800}.brief small{color:var(--muted)}footer{max-width:var(--max);margin:0 auto;border-top:1px solid var(--line);padding:44px 0 28px;display:grid;grid-template-columns:1fr auto;gap:25px;color:var(--muted);font-size:13px}.footer-brand{color:var(--ink)}.footer-links{display:flex;gap:20px}footer small{grid-column:1/-1}.topic-hero,.article-hero,.prose-page{max-width:var(--max);margin:auto;padding:90px 0 70px}.topic-hero h1{font-size:92px}.topic-hero p{font-size:22px;color:var(--muted);max-width:700px}.empty-state{border:1px solid var(--line);padding:50px;background:var(--paper)}.article-hero{max-width:1000px;text-align:center}.article-hero h1{font-size:72px}.article-hero .dek{font-family:Georgia,serif;font-size:24px;max-width:820px;margin:0 auto;color:var(--muted)}.article-meta{display:flex;gap:24px;justify-content:center;margin-top:30px;font-size:11px;font-weight:800}.article-layout{max-width:1100px;margin:auto;display:grid;grid-template-columns:260px 1fr;gap:70px;padding-bottom:100px}.article-layout aside{position:relative}.evidence-card{background:var(--deep);color:white;padding:22px}.evidence-card span,.takeaway span{display:block;font-size:10px;letter-spacing:.14em;font-weight:900}.evidence-card strong{display:block;font-family:Georgia,serif;font-size:30px;margin:8px 0}.evidence-card p{font-size:12px;color:#cbd1d3}.toc{display:flex;flex-direction:column;gap:12px;margin-top:28px;font-size:11px}.toc b{margin-bottom:6px}.toc a{color:var(--muted)}.takeaway{border-left:4px solid var(--accent);padding:22px 26px;background:var(--paper);margin-bottom:60px}.takeaway p{font-family:Georgia,serif;font-size:25px;line-height:1.3;margin:8px 0 0}.article-layout article>section{padding:25px 0 52px;border-bottom:1px solid var(--line)}.section-index{font-family:Georgia,serif;color:var(--accent);font-size:15px}.article-layout article h2{font-family:Georgia,serif;font-size:42px;letter-spacing:-.03em;margin:12px 0}.article-layout article p{font-family:Georgia,serif;font-size:20px;line-height:1.75;color:#343a3c}.research-box{margin-top:58px;background:#e7e5df;padding:34px}.research-box h3{font-family:Georgia,serif;font-size:30px;margin:8px 0}.research-box a{font-size:12px;font-weight:900}.mini-related{border:1px solid var(--line);padding:34px;background:var(--paper)}.mini-related h3{font-family:Georgia,serif;font-size:28px}.mini-related span{font-size:12px;font-weight:900}.prose-page{max-width:850px}.prose-page h1{font-size:70px}.prose-page h2{font-family:Georgia,serif;font-size:36px;margin-top:55px}.prose-page p{font-family:Georgia,serif;font-size:20px;line-height:1.75;color:#343a3c}.prose-page blockquote{font-family:Georgia,serif;font-size:34px;line-height:1.2;border-left:4px solid var(--accent);margin:45px 0;padding-left:26px}
@media(max-width:900px){.site-header{grid-template-columns:1fr auto;padding:0 18px}.site-header nav{display:none}.subnav{padding:0 18px}.hero,.article-card.large,.window{grid-template-columns:1fr}.hero,.lead-section,.frontier,.latest,.topics,.topic-content,.related{padding-left:18px;padding-right:18px}.hero{padding-top:45px;gap:25px}.hero-art{height:390px}.large .card-visual{min-height:320px}.frontier-grid,.topic-grid{grid-template-columns:1fr 1fr}.cards-grid{grid-template-columns:1fr}.window{margin:30px 18px;padding:38px}.window-art{height:280px}.article-layout{grid-template-columns:1fr;padding:0 18px 70px;gap:35px}.toc{display:none}.article-hero,.topic-hero,.prose-page{padding:65px 18px 45px}.article-hero h1{font-size:50px}.article-hero .dek{font-size:20px}.article-meta{flex-wrap:wrap}.section-heading{display:block}.section-heading>p{margin-top:15px}footer{margin:0 18px}.brief h2{font-size:46px}}
@media(max-width:560px){.hero h1{font-size:64px}.hero-copy>p{font-size:18px}.hero-actions{flex-direction:column}.hero-retina{width:310px;height:310px}.frontier-grid,.topic-grid{grid-template-columns:1fr}.frontier-item{border-right:0;border-bottom:1px solid var(--line);padding-left:0!important}.large .card-copy{padding:32px}.large .card-copy h3{font-size:34px}.section-heading h2,.window h2{font-size:42px}.window{padding:30px}.brief form{display:block}.brief input,.brief button{width:100%;min-height:52px}.brief button{margin-top:8px}.footer-links{flex-direction:column}.article-layout article h2{font-size:34px}.article-layout article p{font-size:18px}.prose-page h1{font-size:52px}}
